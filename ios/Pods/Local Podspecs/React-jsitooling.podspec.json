{
  "name": "React-jsitooling",
  "version": "0.88.0",
  "summary": "-",
  "homepage": "https://reactnative.dev/",
  "license": "MIT",
  "authors": "Meta Platforms, Inc. and its affiliates",
  "platforms": {
    "ios": "15.1"
  },
  "source": {
    "git": "https://github.com/facebook/react-native.git",
    "tag": "v0.88.0"
  },
  "source_files": "react/runtime/*.h",
  "header_dir": "react/runtime",
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": "\"${PODS_ROOT}/React-debug\" \"${PODS_ROOT}/React-runtimeexecutor\" \"${PODS_ROOT}/React-runtimeexecutor/platform/ios\" \"${PODS_ROOT}/React-jsinspector\" \"${PODS_ROOT}/React-jsinspectorcdp\" \"${PODS_ROOT}/React-jsinspectortracing\" \"${PODS_ROOT}/React-utils\" \"${PODS_ROOT}/React-utils/react/utils/platform/ios\" \"$(PODS_ROOT)/ReactNativeDependencies/Headers\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "DEFINES_MODULE": "YES",
    "GCC_PREPROCESSOR_DEFINITIONS": "$(inherited) RN_BUILDING=1"
  },
  "dependencies": {
    "React-cxxreact": [
      "0.88.0"
    ],
    "React-jsi": [
      "0.88.0"
    ],
    "React-cxxstableapi": [],
    "React-debug": [],
    "React-runtimeexecutor": [],
    "React-jsinspector": [],
    "React-jsinspectorcdp": [],
    "React-jsinspectortracing": [],
    "React-utils": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  }
}
